# Salin sebagai .env lokal, lalu isi kredensial MySQL pada mesin Anda.
# Jangan commit .env. Nilai berikut hanya konfigurasi lokal contoh.
DASHBOARD_RUNTIME_ENV=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_DATABASE=dashboard_funding_test
MYSQL_USER=your_local_mysql_user
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=5

# Backend API MySQL (default)
SHADOW_API_PORT=8788

# Khusus menu Admin Upload. Kosong berarti semua endpoint Admin ditolak.
# Buat salt dan hash scrypt lokal; jangan commit nilai sebenarnya.
DASHBOARD_ADMIN_USER=
DASHBOARD_ADMIN_PASSWORD_SCRYPT=

# Opsional: hanya untuk server Appraisal Google Sheets legacy, bukan dashboard MySQL.
APPRAISAL_SPREADSHEET_ID=
