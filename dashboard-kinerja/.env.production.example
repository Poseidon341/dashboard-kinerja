# Salin ke /etc/dashboard-funding/backend.env di server Ubuntu; jangan isi rahasia di repository.
NODE_ENV=production
DASHBOARD_RUNTIME_ENV=production

# Koneksi MySQL di jaringan privat. 127.0.0.1 berarti MySQL berjalan di Ubuntu ini.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=dashboard_funding
MYSQL_USER=replace_with_dedicated_mysql_user
MYSQL_PASSWORD=
MYSQL_CONNECTION_LIMIT=5
# Wajib untuk MYSQL_HOST non-loopback: path CA sertifikat server MySQL.
# MYSQL_SSL_CA_FILE=/etc/dashboard-funding/mysql-ca.pem

# Allowlist runtime harus cocok persis dengan MYSQL_HOST/PORT/DATABASE.
DASHBOARD_PRODUCTION_DB_HOST=127.0.0.1
DASHBOARD_PRODUCTION_DB_PORT=3306
DASHBOARD_PRODUCTION_DB_NAME=dashboard_funding

SHADOW_API_PORT=8788
DASHBOARD_PUBLIC_ORIGIN=https://funding.example.com

# Endpoint data production memerlukan sesi Admin. Login PN belum dapat membuka
# data sampai bukti identitas dan aturan otorisasi PN disetujui.

# Login Admin khusus; buat hash scrypt secara lokal menggunakan scripts/generate-admin-hash.mjs.
DASHBOARD_ADMIN_USER=
DASHBOARD_ADMIN_PASSWORD_SCRYPT=
